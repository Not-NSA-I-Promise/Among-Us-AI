# local virtualenv
.venv/

# python bytecode
__pycache__/
*.py[cod]

# compiled task templates are regenerated at runtime from the originals
task-solvers/cv2-templates/* resized/

# runtime state written by the bot on every move - not source
last_area.txt

# written by the Inspect Sample solver when it cannot find the tube
inspect_sample_debug_*.png
fix_wiring_debug_*.png
